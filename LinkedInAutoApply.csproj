<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>TaAplicado</AssemblyName>
    <RootNamespace>LinkedInAutoApply</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.*" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="ClaudeCodeBridge" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="agent-rules.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


</Project>
